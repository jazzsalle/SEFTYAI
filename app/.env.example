# ── 지도·기상 ──
# VWorld 인증키 (브라우저 노출 — VWorld 콘솔에 서비스 도메인 등록 필요, 배경지도·행정경계 WMS)
NEXT_PUBLIC_VWORLD_KEY=
# 기상청 기상특보 조회서비스 일반 인증키 (URL 인코딩된 값)
KMA_SERVICE_KEY=

# ── T3Q 시범서비스 API (서버 전용 — 브라우저에 넣지 않는다) ──
# 예: https://<T3Q 서버>/apps/r/<서비스 토큰>/api/v1
T3Q_BASE_URL=
# 클라이언트 토큰 a2app_… (T3Q 관리자가 발급)
T3Q_CLIENT_TOKEN=
# (선택) 우리 쪽 전체 동시 질의 상한 (기본 8)
T3Q_MAX_GLOBAL=
# (개발·테스트 전용) replay = harness/recordings 녹화본으로 재생. 운영에서는 쓸 수 없다
T3Q_MODE=

# ── DB · 세션 ──
# Neon Postgres (Vercel 통합이 넣어 줌). 로컬 개발은 .env.development.local 에 DATABASE_URL=pglite:.localdb
DATABASE_URL=
# 세션 쿠키 서명 키 (운영 필수, 32바이트 이상 임의값)
SESSION_SECRET=
# 계정 사전 발급 API(/api/auth/seed) 보호 키 — 발급할 때만 설정
SEED_SECRET=
# 상황전파 발송 결과 콜백 서명 (선택)
DISPATCH_CALLBACK_SECRET=
